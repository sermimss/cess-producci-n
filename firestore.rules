rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Global Safety Net & Helpers
    // ===============================================================
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifies email is strictly verified to avoid spoofing
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      // Allow Google email logins for admin
      return isAuthenticated() && request.auth.token.email == "cessplantelchihuahua@gmail.com";
    }

    // Las cuentas de docentes se crean en el backend (POST /api/create-teacher-account)
    // con Firebase Admin SDK, que les asigna este custom claim al momento de crearlas.
    // Antes no existía forma barata de distinguir "docente real" de "cualquier cuenta
    // autenticada" dentro de una regla, así que el directorio de alumnos (CURP, teléfono,
    // domicilio, fecha de nacimiento) quedaba expuesto a cualquiera que se autenticara.
    function isTeacher() {
      return isAuthenticated() && request.auth.token.role == 'teacher';
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function uidUnchanged() {
      return !('userId' in incoming()) || !('userId' in existing()) || incoming().userId == existing().userId;
    }

    // ===============================================================
    // Primitive Blueprint Validators
    // ===============================================================
    function isValidStudent(data) {
      return data.keys().hasAll(['userId', 'nombre', 'apellidoPaterno', 'studyPlan', 'schedule', 'status']) &&
             data.userId is string && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             data.nombre is string && data.nombre.size() <= 100 &&
             data.status in ['Activo', 'Baja', 'Graduado'];
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'studentId', 'amount', 'date', 'description', 'category', 'status']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.date is string && data.date.size() <= 50 &&
             data.description is string && data.description.size() <= 250 &&
             data.category is string && data.category.size() <= 100 &&
             data.status in ['Pagado', 'Pendiente'];
    }

    function isValidTeacher(data) {
      return data.keys().hasAll(['userId', 'name', 'email', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.email is string && data.email.size() <= 200;
    }

    function isValidGroup(data) {
      return data.keys().hasAll(['userId', 'name', 'studyPlan', 'generation', 'classDay', 'scheduleStart', 'scheduleEnd', 'classroom']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.name is string && data.name.size() <= 150 &&
             data.generation is string && data.generation.size() <= 100;
    }

    function isValidSubjectAssignment(data) {
      return data.keys().hasAll(['userId', 'groupId', 'teacherName', 'subjectName', 'classDay', 'startTime', 'endTime', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.groupId is string && data.groupId.size() <= 128 &&
             data.teacherName is string && data.teacherName.size() <= 150 &&
             data.subjectName is string && data.subjectName.size() <= 150;
    }

    function isValidGrade(data) {
      return data.keys().hasAll(['userId', 'studentId', 'groupId', 'subject', 'grade', 'teacherName', 'createdAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.studentId is string && data.studentId.size() <= 128 &&
             data.grade is number && data.grade >= 0 && data.grade <= 100;
    }

    // ===============================================================
    // Protected Routes
    // ===============================================================

    match /students/{studentId} {
      // Admin y docentes (verificados por custom claim) pueden LISTAR el directorio
      // completo. `get` (consultar UN registro por matrícula ya conocida) se deja
      // abierto a cualquier autenticado porque StudentAccountClaim lo necesita para que
      // un alumno recién registrado pueda validar su propia matrícula antes de tener
      // email vinculado; el riesgo real (volcado masivo de PII) era `list`, no `get`.
      // El alumno logueado también hace un `list` (filtrado por su propio email en el
      // cliente) para encontrar su registro; se permite solo cuando el documento
      // devuelto coincide con el correo del token, así que sigue sin poder listar a
      // los demás.
      allow list: if isAdmin() || isTeacher() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow get: if isAdmin() || isAuthenticated();
      // Solo el Admin puede dar de alta o eliminar alumnos
      allow create: if isAdmin() && isValidStudent(incoming());
      // Admin puede actualizar cualquier campo; el alumno solo puede reclamar su matrícula enlazando email y username
      allow update: if 
        (isAdmin() && isValidStudent(incoming()) && uidUnchanged()) ||
        (isAuthenticated() && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'username']) && (!('email' in existing()) || existing().email == "" || existing().email == null) && incoming().email == request.auth.token.email);
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      // Estudiantes solo pueden consultar pagos etiquetados con su email; Admin consulta todos
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentEmail == request.auth.token.email);
      allow create: if isAdmin() && isValidPayment(incoming());
      allow update: if 
        (isAdmin() && isValidPayment(incoming()) && uidUnchanged()) ||
        (isAuthenticated() && incoming().diff(existing()).affectedKeys().hasOnly(['studentEmail']) && (!('studentEmail' in existing()) || existing().studentEmail == "" || existing().studentEmail == null) && incoming().studentEmail == request.auth.token.email);
      allow delete: if isAdmin();
    }

    match /teachers/{teacherId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() && isValidTeacher(incoming());
      allow update: if isAdmin() && isValidTeacher(incoming()) && uidUnchanged();
      allow delete: if isAdmin();
    }

    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() && isValidGroup(incoming());
      allow update: if isAdmin() && isValidGroup(incoming()) && uidUnchanged();
      allow delete: if isAdmin();
    }

    match /studyPlanSubjects/{subjectId} {
      // Seguro para lectura autenticada; edición exclusiva de dirección
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /subjectAssignments/{subjectAssignmentId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && isValidSubjectAssignment(incoming()));
      allow update: if isAdmin() || (isAuthenticated() && isValidSubjectAssignment(incoming()) && uidUnchanged());
      // Solo dirección puede eliminar asignaciones de materias
      allow delete: if isAdmin();
    }

    match /grades/{gradeId} {
      // El alumno solo lee sus propias calificaciones; el docente solo las que él mismo capturó
      // (antes se comprobaba que existiera la llave 'teacherName', que siempre es verdadero y
      // permitía a cualquier usuario autenticado leer todas las calificaciones).
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.studentEmail == request.auth.token.email || resource.data.teacherEmail == request.auth.token.email));
      allow create: if isAdmin() || (isAuthenticated() && isValidGrade(incoming()));
      allow update: if 
        (isAdmin() && isValidGrade(incoming()) && uidUnchanged()) ||
        (isAuthenticated() && incoming().diff(existing()).affectedKeys().hasOnly(['studentEmail']) && (!('studentEmail' in existing()) || existing().studentEmail == "" || existing().studentEmail == null) && incoming().studentEmail == request.auth.token.email);
      // Solo dirección puede eliminar calificaciones; los alumnos no tienen permiso de borrado
      allow delete: if isAdmin();
    }
  }
}
