rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // By default, only the admin can upload things, but authenticated users can read them
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "cessplantelchihuahua@gmail.com";
    }
  }
}
